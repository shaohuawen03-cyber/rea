#!/usr/bin/env bash
# github-fetch —— 从 GitHub 仓库直接抓「原始素材文件」（视频 / 图片 / 音频）
#
# 用途：沙箱、公司内网等只放行 github.com / api.github.com 的环境里，
#       国内平台（小红书/抖音）和 YouTube 都连不上时，仍然能拿到真实的
#       一二布布素材（社区仓库里的原片、表情包、壁纸、精灵图帧序列）。
#
#   github-fetch <owner/repo> [<path> ...] [选项]
#
# 选项
#   --ref R            分支/标签，默认自动探测 main → master
#   --include REGEX    只抓匹配的文件（如 '\.(mp4|jpg)$'），不写 path 时对整仓生效
#   --max-bytes N      单个文件上限，默认 40MB
#   --out DIR          输出根目录，默认 ~/media-raw
#   --zip              整仓打包下载再筛选（文件多时更快）
#
# 产物
#   <out>/04_其他平台素材/GitHub/<owner>__<repo>/[<原目录>/]<文件名>
#   <out>/.../meta.json   下载记录（commit、文件清单、字节数、校验）
set -euo pipefail

ROOT="${MEDIA_TOOLKIT_HOME:-$HOME/.local/media-toolkit}"
FFPROBE_PY="$ROOT/venv/bin/python"
OUT="$HOME/media-raw"; REF=""; INCLUDE=""; MAXB=$((40*1024*1024)); ZIPMODE=0
REPO=""; PATHS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --ref)        REF="$2"; shift 2;;
    --include)    INCLUDE="$2"; shift 2;;
    --max-bytes)  MAXB="$2"; shift 2;;
    --out)        OUT="$2"; shift 2;;
    --zip)        ZIPMODE=1; shift;;
    -h|--help)    sed -n '2,20p' "$0"; exit 0;;
    -*)           echo "未知选项：$1" >&2; exit 2;;
    *)
      if [ -z "$REPO" ]; then REPO="$1"; else PATHS+=("$1"); fi; shift;;
  esac
done
[ -n "$REPO" ] || { sed -n '2,20p' "$0"; exit 2; }
TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
[ -n "$TOKEN" ] || { echo "需要 GITHUB_TOKEN / GH_TOKEN（只读公开仓库可留空但容易被限流）" >&2; }

api() { curl -fsSL -H "Authorization: token $TOKEN" -H "Accept: application/vnd.github+json" "$@"; }

# --- 解析 ref / commit ---
if [ -z "$REF" ]; then
  for cand in main master; do
    api -o /dev/null -w "" "https://api.github.com/repos/$REPO/branches/$cand" 2>/dev/null && { REF="$cand"; break; }
  done
fi
[ -n "$REF" ] || { echo "找不到分支（试 --ref <branch>）" >&2; exit 1; }
COMMIT=$(api "https://api.github.com/repos/$REPO/commits/$REF" | "$FFPROBE_PY" -c 'import sys,json;print(json.load(sys.stdin)["sha"])')
DEST="$OUT/04_其他平台素材/GitHub/${REPO/\//__}"
mkdir -p "$DEST"

say() { printf '\033[1;36m[github-fetch]\033[0m %s\n' "$*"; }
say "$REPO @ $REF ($COMMIT)"
FILES=()

# --- 模式 A：整仓 zip（codeload）+ 正则筛选 ---
if [ "$ZIPMODE" = "1" ] || { [ ${#PATHS[@]} -eq 0 ] && [ -n "$INCLUDE" ]; }; then
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  say "下载整仓 zip（codeload）"
  curl -fsSL -o "$tmp/repo.zip" "https://codeload.github.com/$REPO/zip/$COMMIT"
  unzip -oq "$tmp/repo.zip" -d "$tmp/x"
  inner=$(find "$tmp/x" -mindepth 1 -maxdepth 1 -type d | head -1)
  while IFS= read -r f; do
    rel="${f#$inner/}"
    sz=$(stat -c%s "$f")
    [ "$sz" -gt "$MAXB" ] && { say "跳过（> 上限）：$rel"; continue; }
    mkdir -p "$DEST/$(dirname "$rel")"; cp -f "$f" "$DEST/$rel"; FILES+=("$rel")
  done < <(find "$inner" -type f | grep -Ei "$INCLUDE" | sort)
fi

# --- 模式 B：逐个文件走 contents API（原始字节）---
for p in "${PATHS[@]:-}"; do
  [ -z "$p" ] && continue
  url="https://api.github.com/repos/$REPO/contents/$p?ref=$REF"
  sz=$(api "$url" | "$FFPROBE_PY" -c 'import sys,json;d=json.load(sys.stdin);print(d.get("size",0))')
  [ "$sz" -gt "$MAXB" ] && { say "跳过（$sz 字节 > 上限）：$p"; continue; }
  mkdir -p "$DEST/$(dirname "$p")"
  say "抓取 $p ($sz 字节)"
  curl -fsSL -H "Authorization: token $TOKEN" -H "Accept: application/vnd.github.raw" \
       -o "$DEST/$p" "$url"
  got=$(stat -c%s "$DEST/$p")
  [ "$got" -eq "$sz" ] || { echo "大小不符：期望 $sz，实际 $got" >&2; exit 1; }
  FILES+=("$p")
done

# --- 记录 ---
{
  printf '{\n  "source": "github:%s@%s",\n  "repo": "https://github.com/%s",\n  "commit": "%s",\n  "collected_at": "%s",\n' \
    "$REPO" "$REF" "$REPO" "$COMMIT" "$(date -u +%FT%TZ)"
  printf '  "license_note": "仓库未声明许可证时仅限内部研究与二创参考，不得直接商用",\n'
  printf '  "file_count": %s,\n  "files": [' "${#FILES[@]}"
  first=1
  for f in "${FILES[@]:-}"; do
    [ -z "$f" ] && continue
    [ $first -eq 1 ] || printf ','
    printf '\n    {"path": "%s", "bytes": %s, "sha256": "%s"}' \
      "$f" "$(stat -c%s "$DEST/$f" 2>/dev/null || echo 0)" "$(sha256sum "$DEST/$f" 2>/dev/null | cut -d' ' -f1)"
    first=0
  done
  printf '\n  ]\n}\n'
} > "$DEST/meta.json"
say "完成：${#FILES[@]} 个文件 → $DEST"
